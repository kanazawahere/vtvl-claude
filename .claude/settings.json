{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(python3 -m pytest*)",
      "Bash(pdftotext *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gridcraft-cli convert*)",
      "Bash(gridcraft-cli check*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 scripts/hooks/pre_commit_guard.py"}
        ]
      }
    ]
  }
}
